{
  "name": "mediqueue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "build:web": "tsc -b && vite build",
    "build:api": "tsc --project apps/api/tsconfig.json --noEmit",
    "build": "npm run build:web && npm run build:api",
    "test:api": "tsx --test apps/api/test/health.test.ts",
    "test": "npm run test:api",
    "lint": "oxlint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/vite": "^4.3.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^1.78.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "effect": "^3.22.5"
  }
}
